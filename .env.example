APP_NAME="BTNG Showroom Mobil API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database MySQL (lokal: Laragon/XAMPP) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=btng_showroom
DB_USERNAME=root
DB_PASSWORD=
# Untuk database cloud yang mewajibkan SSL (mis. Aiven), isi path sertifikat CA:
# MYSQL_ATTR_SSL_CA=

# Driver sederhana (tanpa tabel tambahan) agar aman di cloud
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
